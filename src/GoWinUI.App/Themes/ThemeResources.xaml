<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="GoWindowBrush" Color="#CC202020" />
      <SolidColorBrush x:Key="GoLayerBrush" Color="#B82A2A2A" />
      <SolidColorBrush x:Key="GoLayerStrongBrush" Color="#F0353535" />
      <SolidColorBrush x:Key="GoStrokeBrush" Color="#30FFFFFF" />
      <SolidColorBrush x:Key="GoMutedTextBrush" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="GoSuccessBrush" Color="#6CCB91" />
      <SolidColorBrush x:Key="GoWarningBrush" Color="#F0B45A" />
      <SolidColorBrush x:Key="GoDangerBrush" Color="#F76E7D" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="GoWindowBrush" Color="#CCF6F6F6" />
      <SolidColorBrush x:Key="GoLayerBrush" Color="#DFFFFFFF" />
      <SolidColorBrush x:Key="GoLayerStrongBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="GoStrokeBrush" Color="#24242424" />
      <SolidColorBrush x:Key="GoMutedTextBrush" Color="#A6242424" />
      <SolidColorBrush x:Key="GoSuccessBrush" Color="#167D49" />
      <SolidColorBrush x:Key="GoWarningBrush" Color="#9A5A00" />
      <SolidColorBrush x:Key="GoDangerBrush" Color="#B42335" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="GoWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GoLayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GoLayerStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GoStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GoMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GoSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="GoWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="GoDangerBrush" Color="{ThemeResource SystemColorHotlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style x:Key="GoPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="GoSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="GoCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GoLayerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GoStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="GoStatusPillStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GoLayerStrongBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GoStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
</ResourceDictionary>
