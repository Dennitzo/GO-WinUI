<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="GoWinUI.App.Pages.AssistantPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Background="Transparent"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  mc:Ignorable="d">

  <Grid>
    <Grid x:Name="WebViewHost" />

    <Grid
      x:Name="LoadingOverlay"
      Background="{ThemeResource GoWindowBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <ProgressRing Width="34" Height="34" IsActive="True" />
        <TextBlock
          Foreground="{ThemeResource GoMutedTextBrush}"
          Text="AI Assistent wird vorbereitet …" />
      </StackPanel>
    </Grid>

    <InfoBar
      x:Name="ErrorBar"
      Margin="18"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      IsClosable="True"
      IsOpen="False"
      Severity="Error"
      Title="Der AI Assistent konnte nicht geladen werden" />
  </Grid>
</Page>
