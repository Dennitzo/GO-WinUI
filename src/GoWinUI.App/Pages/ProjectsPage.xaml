<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="GoWinUI.App.Pages.ProjectsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:models="using:GoWinUI.Core.Models"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Background="Transparent"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
  mc:Ignorable="d">

  <Page.Resources>
    <DataTemplate x:Key="ProjectFileItemTemplate" x:DataType="models:ProjectAsset">
      <Grid
        MinHeight="68"
        ColumnSpacing="11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
          Width="46"
          Height="46"
          Background="{ThemeResource GoLayerStrongBrush}"
          BorderBrush="{ThemeResource GoStrokeBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
            <FontIcon FontSize="16" Loaded="OnAssetFormatIconLoaded" />
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="8"
              FontWeight="Bold"
              Loaded="OnAssetFormatBadgeLoaded" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
          <TextBlock
            Foreground="{ThemeResource GoMutedTextBrush}"
            FontSize="12"
            Loaded="OnAssetTypeTextLoaded"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Foreground="{ThemeResource GoMutedTextBrush}"
            FontSize="11"
            Loaded="OnAssetModifiedTextLoaded"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBox
          Grid.Column="2"
          Width="260"
          Height="36"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          AutomationProperties.Name="Dateiüberschrift"
          KeyDown="OnAssetTitleKeyDown"
          LostFocus="OnAssetTitleLostFocus"
          MaxLength="200"
          PlaceholderText="Überschrift eingeben"
          Text="{x:Bind Title}" />
        <StackPanel
          Grid.Column="3"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="9">
          <TextBlock
            x:Name="AssetSizeText"
            VerticalAlignment="Center"
            Foreground="{ThemeResource GoMutedTextBrush}"
            FontSize="12"
            Loaded="OnAssetSizeTextLoaded" />
          <Button
            x:Name="AssetDeleteButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AutomationProperties.Name="Datei löschen"
            Click="OnDeleteAsset"
            ToolTipService.ToolTip="Löschen">
            <FontIcon FontSize="13" Glyph="&#xE74D;" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProjectImageItemTemplate" x:DataType="models:ProjectAsset">
      <Grid
        Width="164"
        Height="132"
        Background="Transparent">
        <Border
          Background="{ThemeResource GoLayerStrongBrush}"
          BorderBrush="{ThemeResource GoStrokeBrush}"
          BorderThickness="1"
          CornerRadius="9">
          <Grid>
            <FontIcon
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="28"
              Foreground="{ThemeResource GoMutedTextBrush}"
              Glyph="&#xEB9F;" />
            <Image Margin="2" Loaded="OnAssetThumbnailLoaded" Stretch="UniformToFill" />
            <Border
              VerticalAlignment="Bottom"
              Padding="8,6"
              Background="#B2181320"
              CornerRadius="0,0,8,8">
              <StackPanel Spacing="1">
                <TextBlock
                  Foreground="White"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Text="{x:Bind FileName}"
                  TextTrimming="CharacterEllipsis" />
                <TextBlock
                  Foreground="#D9FFFFFF"
                  FontSize="9"
                  Loaded="OnAssetModifiedTextLoaded"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border
              Margin="7"
              Padding="5,2"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Background="#D9181320"
              CornerRadius="5">
              <TextBlock
                Foreground="White"
                FontSize="8"
                FontWeight="Bold"
                Loaded="OnAssetFormatBadgeLoaded" />
            </Border>
            <Button
              x:Name="AssetDeleteButton"
              Margin="7"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              AutomationProperties.Name="Bild löschen"
              Click="OnDeleteAsset"
              ToolTipService.ToolTip="Löschen">
              <FontIcon FontSize="13" Glyph="&#xE74D;" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid
    Margin="28,24,28,0"
    VerticalAlignment="Stretch"
    RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <TextBlock x:Name="PageTitleText" Style="{StaticResource GoPageTitleStyle}" Text="Projekte" />
        <TextBlock
          x:Name="PageDescriptionText"
          Foreground="{ThemeResource GoMutedTextBrush}"
          Text="Projektinformationen, Checklisten und Dateien übersichtlich verwalten."
          TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <Button Click="OnCreateProject" Style="{StaticResource GoPrimaryButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon FontSize="14" Glyph="&#xE710;" />
            <TextBlock Text="Neues Projekt" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <InfoBar
      x:Name="ErrorBar"
      Grid.Row="1"
      IsClosable="True"
      IsOpen="False"
      Severity="Error"
      Title="Aktion fehlgeschlagen" />

    <Grid Grid.Row="2">
      <ScrollViewer
        x:Name="ProjectMasterPane"
        HorizontalScrollBarVisibility="Disabled"
        Padding="0,0,0,24"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18">
          <Border Padding="12" Style="{StaticResource GoCardStyle}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Projektübersicht" />
                <TextBlock
                  Foreground="{ThemeResource GoMutedTextBrush}"
                  Text="Projekt auswählen, um die vollständige Projektseite zu öffnen."
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                x:Name="ArchivedToggle"
                Grid.Column="1"
                Header="Archiv"
                Toggled="OnArchiveFilterChanged" />
            </Grid>
          </Border>

          <GridView
            x:Name="ProjectList"
            HorizontalAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="OnProjectItemClick"
            ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemContainerStyle>
              <Style TargetType="GridViewItem">
                <Setter Property="Width" Value="310" />
                <Setter Property="Height" Value="184" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
              </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
              <DataTemplate x:DataType="models:Project">
                <Border Padding="18" Style="{StaticResource GoCardStyle}">
                  <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border
                        Width="34"
                        Height="34"
                        Background="{ThemeResource GoLayerStrongBrush}"
                        CornerRadius="7">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                      </Border>
                      <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock
                      Grid.Row="1"
                      Foreground="{ThemeResource GoMutedTextBrush}"
                      Text="{x:Bind ConstructionProject, FallbackValue='Ohne Bauvorhaben'}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Grid.Row="2"
                      MaxLines="2"
                      Foreground="{ThemeResource GoMutedTextBrush}"
                      Text="{x:Bind Description, FallbackValue='Ohne Beschreibung'}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="WrapWholeWords" />
                    <TextBlock
                      Grid.Row="3"
                      HorizontalAlignment="Right"
                      FontWeight="SemiBold"
                      Foreground="{ThemeResource GoAccentBrush}"
                      Text="Öffnen →" />
                  </Grid>
                </Border>
              </DataTemplate>
            </GridView.ItemTemplate>
          </GridView>

          <StackPanel
            x:Name="ProjectEmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
              HorizontalAlignment="Center"
              FontSize="30"
              Foreground="{ThemeResource GoMutedTextBrush}"
              Glyph="&#xE838;" />
            <TextBlock
              Foreground="{ThemeResource GoMutedTextBrush}"
              Text="Keine Projekte in dieser Ansicht vorhanden." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer
        x:Name="ProjectDetailsPane"
        HorizontalScrollBarVisibility="Disabled"
        IsTabStop="True"
        Padding="0,0,0,24"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto"
        Visibility="Collapsed">
        <StackPanel Spacing="14">
          <Button
            HorizontalAlignment="Left"
            Click="OnBackToProjects"
            Style="{StaticResource GoSubtleButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontSize="13" Glyph="&#xE72B;" />
              <TextBlock Text="Zurück zu Projekten" />
            </StackPanel>
          </Button>
          <Border Style="{StaticResource GoCardStyle}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Projektdetails" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Click="OnDeleteProject" Content="Löschen" Foreground="{ThemeResource GoDangerBrush}" />
                  <Button Click="OnToggleArchive" Content="{x:Bind ViewModel.ArchiveActionLabel, Mode=OneWay}" />
                  <Button Click="OnSaveProject" Content="Speichern" Style="{StaticResource GoPrimaryButtonStyle}" />
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="Projektname" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Header="Bauvorhaben" Text="{x:Bind ViewModel.ConstructionProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
              <TextBox
                AcceptsReturn="True"
                Header="Beschreibung"
                MinHeight="80"
                Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
              <TextBox
                AcceptsReturn="True"
                Header="Notizen"
                MinHeight="90"
                Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource GoCardStyle}">
            <Grid RowSpacing="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Checkliste" />
              <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                  PlaceholderText="Neuer Checklistenpunkt"
                  Text="{x:Bind ViewModel.NewChecklistText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Click="OnAddChecklistItem" Content="Hinzufügen" />
              </Grid>
              <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Checklist, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="models:ChecklistItem">
                    <Border
                      Margin="0,3"
                      Padding="10,7"
                      Background="{ThemeResource GoLayerStrongBrush}"
                      BorderBrush="{ThemeResource GoStrokeBrush}"
                      BorderThickness="1"
                      CornerRadius="9">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsCompleted}" Click="OnChecklistClicked" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Text}" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Click="OnMoveChecklistItemUp" ToolTipService.ToolTip="Nach oben">
                          <FontIcon FontSize="13" Glyph="&#xE70E;" />
                        </Button>
                        <Button Grid.Column="3" Click="OnMoveChecklistItemDown" ToolTipService.ToolTip="Nach unten">
                          <FontIcon FontSize="13" Glyph="&#xE70D;" />
                        </Button>
                        <Button Grid.Column="4" Click="OnDeleteChecklistItem" ToolTipService.ToolTip="Löschen">
                          <FontIcon FontSize="13" Glyph="&#xE74D;" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <Border Style="{StaticResource GoCardStyle}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Baupläne" />
                  <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Grundrisse, Schnitte und Planunterlagen im PDF-Format." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnImportAsset" Content="Baupläne hinzufügen" Style="{StaticResource GoPrimaryButtonStyle}" Tag="Pdf" />
              </Grid>
              <ListView
                x:Name="ConstructionPlanList"
                MaxHeight="230"
                IsItemClickEnabled="True"
                ItemTemplate="{StaticResource ProjectFileItemTemplate}"
                ItemClick="OnAssetItemClick"
                ItemsSource="{x:Bind ViewModel.ConstructionPlans, Mode=OneWay}"
                SelectionMode="None" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource GoCardStyle}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Bauzeichnungen" />
                  <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="CAD- und BIM-Zeichnungen, zum Beispiel DWG oder RVT." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnImportAsset" Content="Zeichnungen hinzufügen" Style="{StaticResource GoPrimaryButtonStyle}" Tag="Drawing" />
              </Grid>
              <ListView
                x:Name="ConstructionDrawingList"
                MaxHeight="230"
                IsItemClickEnabled="True"
                ItemTemplate="{StaticResource ProjectFileItemTemplate}"
                ItemClick="OnAssetItemClick"
                ItemsSource="{x:Bind ViewModel.ConstructionDrawings, Mode=OneWay}"
                SelectionMode="None" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource GoCardStyle}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Baubesprechungen" />
                  <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Protokolle, Notizen und Unterlagen aus Projektbesprechungen." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnImportAsset" Content="Besprechungsdateien hinzufügen" Style="{StaticResource GoPrimaryButtonStyle}" Tag="Meeting" />
              </Grid>
              <ListView
                x:Name="MeetingFileList"
                MaxHeight="230"
                IsItemClickEnabled="True"
                ItemTemplate="{StaticResource ProjectFileItemTemplate}"
                ItemClick="OnAssetItemClick"
                ItemsSource="{x:Bind ViewModel.MeetingFiles, Mode=OneWay}"
                SelectionMode="None" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource GoCardStyle}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Sonstige Dateien" />
                  <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Weitere projektbezogene Dokumente und Dateiformate." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnImportAsset" Content="Dateien hinzufügen" Style="{StaticResource GoPrimaryButtonStyle}" Tag="Other" />
              </Grid>
              <ListView
                x:Name="OtherFileList"
                MaxHeight="230"
                IsItemClickEnabled="True"
                ItemTemplate="{StaticResource ProjectFileItemTemplate}"
                ItemClick="OnAssetItemClick"
                ItemsSource="{x:Bind ViewModel.OtherFiles, Mode=OneWay}"
                SelectionMode="None" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource GoCardStyle}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Bilder" />
                  <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Baustellenfotos und Projektdokumentation mit direkter Vorschau." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnImportAsset" Content="Bilder hinzufügen" Style="{StaticResource GoPrimaryButtonStyle}" Tag="Image" />
              </Grid>
              <GridView
                x:Name="ImageAssetList"
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemTemplate="{StaticResource ProjectImageItemTemplate}"
                ItemClick="OnAssetItemClick"
                ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemContainerStyle>
                  <Style TargetType="GridViewItem">
                    <Setter Property="Width" Value="176" />
                    <Setter Property="Height" Value="144" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  </Style>
                </GridView.ItemContainerStyle>
              </GridView>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid
      x:Name="FileOpeningOverlay"
      Grid.RowSpan="3"
      Canvas.ZIndex="100"
      Background="#38000000"
      IsHitTestVisible="True"
      Visibility="Collapsed">
      <Border
        MinWidth="300"
        MaxWidth="440"
        Padding="24,20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource GoLayerBrush}"
        BorderBrush="{ThemeResource GoStrokeBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel HorizontalAlignment="Center" Spacing="12">
          <ProgressRing
            Width="34"
            Height="34"
            HorizontalAlignment="Center"
            IsActive="True" />
          <TextBlock
            x:Name="FileOpeningMessage"
            FontWeight="SemiBold"
            Text="Datei wird geöffnet …"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
