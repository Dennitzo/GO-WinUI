<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="GoWinUI.App.Pages.LogsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Background="Transparent"
  Loaded="OnLoaded"
  mc:Ignorable="d">

  <Grid
    Margin="28,24,28,40"
    HorizontalAlignment="Stretch"
    RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="6">
      <TextBlock Style="{StaticResource GoPageTitleStyle}" Text="Ausführungslog" />
      <TextBlock
        Foreground="{ThemeResource GoMutedTextBrush}"
        Text="Laufende Anwendungsdiagnose im Klartext."
        TextWrapping="Wrap" />
    </StackPanel>

    <TextBox
      x:Name="LogTextBox"
      Grid.Row="1"
      MinHeight="260"
      Padding="16"
      AcceptsReturn="True"
      AutomationProperties.Name="Ausführungslog als Klartext"
      FontFamily="Cascadia Mono"
      FontSize="13"
      IsReadOnly="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
      TextChanged="OnLogTextChanged"
      TextWrapping="NoWrap" />
  </Grid>
</Page>
