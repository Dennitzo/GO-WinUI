<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="GoWinUI.App.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:GoWinUI.App.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:tv="using:WinUI.TableView"
  xmlns:viewModels="using:GoWinUI.App.ViewModels"
  Background="Transparent"
  Loaded="OnLoaded"
  mc:Ignorable="d">

  <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24" HorizontalAlignment="Stretch" Spacing="16">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource GoPageTitleStyle}" Text="Einstellungen" />
          <TextBlock
            Margin="0,4,0,0"
            Foreground="{ThemeResource GoMutedTextBrush}"
            Text="GO AI Server, Prompt-Trigger, lokale Werkzeuge, Darstellung und Datensicherung konfigurieren."
            TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Click="OnSave" Content="Speichern" Style="{StaticResource GoPrimaryButtonStyle}" />
      </Grid>

      <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False" Severity="Informational" />

      <Border Style="{StaticResource GoCardStyle}">
        <StackPanel Spacing="14">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="AI-Verbindung" />
              <TextBlock
                Margin="0,3,0,0"
                Foreground="{ThemeResource GoMutedTextBrush}"
                Text="Im GO AI Server unter „Sicherheit und Schlüssel“ einen GO-Client API-Schlüssel erzeugen, kopieren und hier einfügen."
                TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource GoStatusPillStyle}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ProgressRing Width="15" Height="15" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock MaxWidth="300" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="5">
              <PasswordBox
                x:Name="ApiKeyBox"
                Header="GO-AI-Server-Schlüssel"
                PasswordChanged="OnApiKeyChanged"
                PlaceholderText="Auf dem Server erzeugten Schlüssel einfügen" />
              <TextBlock x:Name="ApiKeyStateText" FontSize="12" Foreground="{ThemeResource GoMutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
              <Button Click="OnDeleteApiKey" Content="Gespeicherten Schlüssel löschen" />
              <Button Click="OnRefreshModels" Content="Verbindung testen und Fähigkeiten laden" Style="{StaticResource GoPrimaryButtonStyle}" />
            </StackPanel>
          </Grid>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBox
              Header="Freigegebener lokaler Tool-Workspace"
              PlaceholderText="Optional · z. B. C:\Projekte\TGA"
              Text="{x:Bind ViewModel.LocalToolWorkspacePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Margin="0,24,0,0" Click="OnSelectWorkspace" Content="Ordner wählen" />
            <ComboBox x:Name="CaptionLanguageBox" Grid.Column="2" Header="Sprache für Untertitel" SelectionChanged="OnCaptionLanguageChanged">
              <ComboBoxItem Content="Deutsch" Tag="de" />
              <ComboBoxItem Content="Englisch" Tag="en" />
              <ComboBoxItem Content="Automatisch" Tag="auto" />
            </ComboBox>
          </Grid>

          <ComboBox
            x:Name="ModelBox"
            DisplayMemberPath="Id"
            Header="Verfügbare AI-Servermodelle"
            ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
            PlaceholderText="Verbindung testen"
            SelectionChanged="OnModelChanged" />

        </StackPanel>
      </Border>

      <Border Style="{StaticResource GoCardStyle}">
        <StackPanel Spacing="14">
          <StackPanel>
            <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Darstellung" />
            <TextBlock Margin="0,3,0,0" Foreground="{ThemeResource GoMutedTextBrush}" Text="Akzentfarbe und Hintergrundoptik lassen sich unabhängig für GO und den AI-Assistenten einstellen." TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="10">
            <ComboBox x:Name="ThemeBox" Header="App-Theme" SelectionChanged="OnThemeChanged">
              <ComboBoxItem Content="Windows-Systemeinstellung" Tag="System" />
              <ComboBoxItem Content="Hell" Tag="Light" />
              <ComboBoxItem Content="Dunkel" Tag="Dark" />
            </ComboBox>
            <ComboBox x:Name="LanguageBox" Header="Sprache" SelectionChanged="OnLanguageChanged">
              <ComboBoxItem Content="Deutsch" Tag="de-DE" />
              <ComboBoxItem Content="English" Tag="en-US" />
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="Akzentfarbe" />
            <ListView x:Name="AccentColorList" HorizontalAlignment="Stretch" ItemsSource="{x:Bind AccentColors}" SelectionChanged="OnAccentColorChanged" SelectionMode="Single">
              <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinWidth" Value="118" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate><DataTemplate x:DataType="local:SettingsAccentColorOption"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="24" Height="24" Fill="{x:Bind PreviewBrush}" Stroke="{ThemeResource GoStrokeBrush}" StrokeThickness="1" /><TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="Hintergrundfarbe" />
            <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Standard, Grau, Dunkel und Schwarz erzeugen eine neutrale Hell-/Dunkelmodus-Optik; weitere Farben tönen die Flächen ein." TextWrapping="Wrap" />
            <ListView x:Name="BackgroundColorList" HorizontalAlignment="Stretch" ItemsSource="{x:Bind BackgroundColors}" SelectionChanged="OnBackgroundColorChanged" SelectionMode="Single">
              <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinWidth" Value="118" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate><DataTemplate x:DataType="local:SettingsAccentColorOption"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="24" Height="24" Fill="{x:Bind PreviewBrush}" Stroke="{ThemeResource GoStrokeBrush}" StrokeThickness="1" /><TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GoCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Sicherung" />
          <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Chats, Workflows, Projekte, Dateien, Trigger und Einstellungen in einer .gobackup-Datei sichern. Backups sind nicht verschlüsselt." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnCreateBackup" Content="Backup erstellen" Style="{StaticResource GoPrimaryButtonStyle}" />
            <Button Click="OnRestoreBackup" Content="Backup wiederherstellen" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Prompt-Trigger" />
          <TextBlock
            Foreground="{ThemeResource GoMutedTextBrush}"
            Text="Aktive Phrasen werden als Präfix erkannt und routen die Anfrage deterministisch zum zugeordneten Dienst."
            TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
          IsClosable="False"
          IsOpen="True"
          Message="Triggerphrase, Beschreibung, Kategorie und Aktivstatus können direkt in der Tabelle bearbeitet werden. Änderungen werden mit „Speichern“ in GO.db übernommen."
          Severity="Informational"
          Title="Dienst-Routing" />

        <Border Style="{StaticResource GoCardStyle}">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Prompt-Trigger hinzufügen" />
              <TextBlock
                Foreground="{ThemeResource GoMutedTextBrush}"
                Text="Dienst auswählen und eine neue Triggerphrase als Tabellenzeile anlegen."
                TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnSpacing="10" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox
                x:Name="NewTriggerActionBox"
                Header="Kategorie"
                DisplayMemberPath="Label"
                ItemsSource="{x:Bind ViewModel.TriggerActions, Mode=OneWay}"
                PlaceholderText="Dienst auswählen" />
              <TextBox
                x:Name="NewTriggerPhraseBox"
                Grid.Column="1"
                Header="Neue Triggerphrase"
                MaxLength="160"
                PlaceholderText="Zum Beispiel: Erstelle ein Bild" />
              <Button
                x:Name="AddTriggerButton"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Click="OnAddTrigger"
                Content="Zeile hinzufügen"
                Style="{StaticResource GoPrimaryButtonStyle}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Padding="0" Style="{StaticResource GoCardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
              Padding="12,10"
              Background="{ThemeResource GoLayerStrongBrush}"
              ColumnSpacing="12"
              RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <AutoSuggestBox
                x:Name="TriggerSearchBox"
                Grid.ColumnSpan="3"
                AutomationProperties.Name="Prompt-Trigger durchsuchen"
                PlaceholderText="Tabelle durchsuchen …"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.TriggerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="OnTriggerSearchTextChanged" />
              <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource GoMutedTextBrush}"
                Text="Eine oder mehrere Zeilen auswählen, um sie zu löschen."
                TextWrapping="Wrap" />
              <ComboBox
                x:Name="TriggerCategoryFilterBox"
                Grid.Row="1"
                Grid.Column="1"
                MinWidth="220"
                AutomationProperties.Name="Prompt-Trigger nach Kategorie filtern"
                DisplayMemberPath="Label"
                ItemsSource="{x:Bind ViewModel.TriggerCategoryFilters, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedTriggerCategoryFilter, Mode=TwoWay}" />
              <Button
                x:Name="DeleteTriggerRowsButton"
                Grid.Row="1"
                Grid.Column="2"
                AutomationProperties.Name="Ausgewählte Prompt-Trigger löschen"
                Click="OnDeleteSelectedTriggers"
                IsEnabled="{x:Bind ViewModel.CanDeleteSelectedPromptTrigger, Mode=OneWay}"
                Style="{StaticResource GoDangerButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <SymbolIcon Symbol="Delete" />
                  <TextBlock Text="Zeile löschen" />
                </StackPanel>
              </Button>
            </Grid>

            <tv:TableView
              x:Name="PromptTriggerTable"
              Grid.Row="1"
              Height="460"
              AutomationProperties.Name="Sortierbare Prompt-Trigger"
              AutoGenerateColumns="False"
              CellEditEnded="OnPromptTriggerCellEditEnded"
              CanFilterColumns="False"
              CanReorderColumns="False"
              CanResizeColumns="True"
              CanSortColumns="True"
              IsReadOnly="False"
              ItemsSource="{x:Bind ViewModel.VisiblePromptTriggers, Mode=OneWay}"
              MaxColumnWidth="900"
              MinColumnWidth="72"
              SelectionChanged="OnPromptTriggerSelectionChanged"
              SelectionMode="Multiple"
              ShowExportOptions="False"
              Sorting="OnPromptTriggerTableSorting">
              <tv:TableView.Columns>
                <tv:TableViewTextColumn
                  Binding="{Binding Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  CanResize="True"
                  CanSort="True"
                  Header="Triggerphrase"
                  IsReadOnly="False"
                  SortMemberPath="Phrase"
                  Tag="Phrase"
                  Width="2*" />
                <tv:TableViewTemplateColumn
                  CanResize="True"
                  CanSort="True"
                  Header="Kategorie"
                  IsReadOnly="False"
                  SortMemberPath="Action"
                  Tag="Action"
                  Width="220">
                  <tv:TableViewTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="viewModels:PromptTriggerEditorItem">
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ActionDisplayName}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ActionDisplayName}" />
                    </DataTemplate>
                  </tv:TableViewTemplateColumn.CellTemplate>
                  <tv:TableViewTemplateColumn.EditingTemplate>
                    <DataTemplate x:DataType="viewModels:PromptTriggerEditorItem">
                      <ComboBox
                        MinWidth="190"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ActionOptions}"
                        SelectedItem="{x:Bind SelectedActionOption, Mode=TwoWay}" />
                    </DataTemplate>
                  </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTextColumn
                  Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  CanResize="True"
                  CanSort="True"
                  Header="Beschreibung"
                  IsReadOnly="False"
                  SortMemberPath="Description"
                  Tag="Description"
                  Width="2*" />
                <tv:TableViewTemplateColumn
                  CanResize="True"
                  CanSort="True"
                  Header="Aktiv"
                  IsReadOnly="True"
                  SortMemberPath="IsEnabled"
                  Tag="IsEnabled"
                  Width="100">
                  <tv:TableViewTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="viewModels:PromptTriggerEditorItem">
                      <ToggleSwitch
                        AutomationProperties.Name="Prompt-Trigger aktivieren oder deaktivieren"
                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent=""
                        Tag="{x:Bind}" />
                    </DataTemplate>
                  </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
              </tv:TableView.Columns>
            </tv:TableView>
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
