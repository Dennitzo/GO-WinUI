<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="GoWinUI.App.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:GoWinUI.App.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Background="Transparent"
  Loaded="OnLoaded"
  mc:Ignorable="d">

  <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="24" HorizontalAlignment="Stretch" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource GoPageTitleStyle}" Text="Einstellungen" />
          <TextBlock
            Margin="0,4,0,0"
            Foreground="{ThemeResource GoMutedTextBrush}"
            Text="Lokales Modell, Darstellung und Datensicherung konfigurieren."
            TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Click="OnSave" Content="Speichern" Style="{StaticResource GoPrimaryButtonStyle}" />
      </Grid>

      <InfoBar
        x:Name="StatusBar"
        Grid.Row="1"
        IsClosable="True"
        IsOpen="False"
        Severity="Informational" />

      <Border Grid.Row="2" Style="{StaticResource GoCardStyle}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="LM Studio" />
              <TextBlock Margin="0,3,0,0" Foreground="{ThemeResource GoMutedTextBrush}" Text="OpenAI-kompatibles Modell vollständig lokal verwenden." />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource GoStatusPillStyle}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ProgressRing Width="15" Height="15" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="10">
            <TextBox
              Header="Basisadresse"
              PlaceholderText="http://127.0.0.1:1234/v1"
              Text="{x:Bind ViewModel.LmStudioBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button HorizontalAlignment="Left" Click="OnRefreshModels" Content="Verbindung testen und Modelle laden" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="10">
            <ComboBox
              x:Name="ModelBox"
              DisplayMemberPath="Id"
              Header="Geladenes Modell"
              ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
              PlaceholderText="Verbindung testen"
              SelectionChanged="OnModelChanged" />
            <ComboBox x:Name="ReasoningBox" Header="Reasoning-Aufwand" SelectionChanged="OnReasoningChanged">
              <ComboBoxItem Content="Niedrig" Tag="low" />
              <ComboBoxItem Content="Mittel" Tag="medium" />
              <ComboBoxItem Content="Hoch" Tag="high" />
            </ComboBox>
          </StackPanel>
          <TextBlock
            Grid.Row="3"
            Foreground="{ThemeResource GoMutedTextBrush}"
            Text="Standard: http://127.0.0.1:1234/v1. GO sendet keine Anfrage an einen Cloud-Anbieter."
            TextWrapping="Wrap" />
        </Grid>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource GoCardStyle}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Darstellung" />
            <TextBlock
              Margin="0,3,0,0"
              Foreground="{ThemeResource GoMutedTextBrush}"
              Text="Akzentfarbe und Hintergrundoptik lassen sich unabhängig für GO und den AI-Assistenten einstellen."
              TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="10">
            <ComboBox x:Name="ThemeBox" Header="App-Theme" SelectionChanged="OnThemeChanged">
              <ComboBoxItem Content="Windows-Systemeinstellung" Tag="System" />
              <ComboBoxItem Content="Hell" Tag="Light" />
              <ComboBoxItem Content="Dunkel" Tag="Dark" />
            </ComboBox>
            <ComboBox x:Name="LanguageBox" Header="Sprache" SelectionChanged="OnLanguageChanged">
              <ComboBoxItem Content="Deutsch" Tag="de-DE" />
              <ComboBoxItem Content="English" Tag="en-US" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="Akzentfarbe" />
            <ListView
              x:Name="AccentColorList"
              HorizontalAlignment="Stretch"
              IsItemClickEnabled="False"
              ItemsSource="{x:Bind AccentColors}"
              SelectionChanged="OnAccentColorChanged"
              SelectionMode="Single">
              <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListView.ItemsPanel>
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="MinWidth" Value="118" />
                  <Setter Property="Margin" Value="0,0,8,8" />
                  <Setter Property="Padding" Value="8" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SettingsAccentColorOption">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse
                      Width="24"
                      Height="24"
                      Fill="{x:Bind PreviewBrush}"
                      Stroke="{ThemeResource GoStrokeBrush}"
                      StrokeThickness="1" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="7">
            <TextBlock FontWeight="SemiBold" Text="Hintergrundfarbe" />
            <TextBlock
              Foreground="{ThemeResource GoMutedTextBrush}"
              Text="Standard, Grau, Dunkel und Schwarz erzeugen eine neutrale Hell-/Dunkelmodus-Optik; die weiteren Farben tönen die Flächen ein."
              TextWrapping="Wrap" />
            <ListView
              x:Name="BackgroundColorList"
              HorizontalAlignment="Stretch"
              IsItemClickEnabled="False"
              ItemsSource="{x:Bind BackgroundColors}"
              SelectionChanged="OnBackgroundColorChanged"
              SelectionMode="Single">
              <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListView.ItemsPanel>
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="MinWidth" Value="118" />
                  <Setter Property="Margin" Value="0,0,8,8" />
                  <Setter Property="Padding" Value="8" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SettingsAccentColorOption">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse
                      Width="24"
                      Height="24"
                      Fill="{x:Bind PreviewBrush}"
                      Stroke="{ThemeResource GoStrokeBrush}"
                      StrokeThickness="1" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="4" Spacing="14">
        <Border Style="{StaticResource GoCardStyle}">
          <StackPanel Spacing="12">
            <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Sicherung" />
            <TextBlock
              Foreground="{ThemeResource GoMutedTextBrush}"
              Text="Chats, Workflows, Projekte, Dateien und Einstellungen in einer .gobackup-Datei sichern. Backups sind nicht verschlüsselt."
              TextWrapping="Wrap" />
            <StackPanel Spacing="8">
              <Button HorizontalAlignment="Left" Click="OnCreateBackup" Content="Backup erstellen" Style="{StaticResource GoPrimaryButtonStyle}" />
              <Button HorizontalAlignment="Left" Click="OnRestoreBackup" Content="Backup wiederherstellen" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GoCardStyle}">
          <StackPanel Spacing="10">
            <TextBlock Style="{StaticResource GoSectionTitleStyle}" Text="Über GO" />
            <TextBlock Text="GO · WinUI 3" />
            <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="Lokaler AI-Arbeitsbereich für Windows x64" />
            <TextBlock Foreground="{ThemeResource GoMutedTextBrush}" Text="WebView2 Evergreen Runtime erforderlich" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
