<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="GoWinUI.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
  Title="GO"
  mc:Ignorable="d">

  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>

  <Grid Background="{ThemeResource GoWindowBrush}">
    <Grid.Resources>
      <Style
        x:Key="GoNavigationPaneToggleButtonStyle"
        BasedOn="{StaticResource PaneToggleButtonStyle}"
        TargetType="Button">
      <Setter Property="Height" Value="38" />
        <Setter Property="RenderTransform">
          <Setter.Value>
            <TranslateTransform Y="5.333" />
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid
      x:Name="AppTitleBar"
      Grid.Row="0"
      Padding="16,0,152,0"
      Background="{ThemeResource GoLayerBrush}"
      ColumnSpacing="12">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="ExpandedTitleBar">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="900" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="WorkspaceSubtitle.Visibility" Value="Visible" />
              <Setter Target="TitleStatus.Visibility" Value="Visible" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="CompactTitleBar">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="WorkspaceSubtitle.Visibility" Value="Collapsed" />
              <Setter Target="TitleStatus.Visibility" Value="Collapsed" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid
        MinWidth="0"
        VerticalAlignment="Center"
        ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          Text="GO" />
        <TextBlock
          x:Name="WorkspaceSubtitle"
          Grid.Column="1"
          MaxLines="1"
          VerticalAlignment="Center"
          Foreground="{ThemeResource GoMutedTextBrush}"
          Text="Lokaler AI-Arbeitsbereich"
          TextTrimming="CharacterEllipsis" />
      </Grid>

      <StackPanel
        x:Name="TitleStatus"
        Grid.Column="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="8">
        <Border
          BorderBrush="{ThemeResource GoWarningBrush}"
          Style="{StaticResource GoStatusPillStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse
              Width="8"
              Height="8"
              Fill="{ThemeResource GoWarningBrush}" />
            <TextBlock
              MaxWidth="170"
              Foreground="{ThemeResource GoWarningBrush}"
              Text="{x:Bind ViewModel.DatabaseStatus, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border
          BorderBrush="{ThemeResource GoWarningBrush}"
          Style="{StaticResource GoStatusPillStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse
              Width="8"
              Height="8"
              Fill="{ThemeResource GoWarningBrush}" />
            <TextBlock
              MaxWidth="170"
              Foreground="{ThemeResource GoWarningBrush}"
              Text="{x:Bind ViewModel.AiConnectionModeText, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border
      Grid.Row="0"
      Height="1"
      VerticalAlignment="Bottom"
      Background="{ThemeResource GoStrokeBrush}"
      IsHitTestVisible="False" />

    <NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      AlwaysShowHeader="False"
      Background="Transparent"
      CompactModeThresholdWidth="840"
      ExpandedModeThresholdWidth="1000"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="True"
      IsSettingsVisible="False"
      IsTitleBarAutoPaddingEnabled="False"
      Loaded="OnNavigationLoaded"
      OpenPaneLength="320"
      PaneToggleButtonStyle="{StaticResource GoNavigationPaneToggleButtonStyle}"
      PaneDisplayMode="Auto"
      SelectionChanged="OnSelectionChanged">

      <NavigationView.PaneHeader>
        <Grid
          x:Name="PaneHeaderLayout"
          MinHeight="132"
          Margin="12,6,0,18">
          <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="38" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
              VerticalAlignment="Center"
              FontSize="18"
              FontWeight="SemiBold"
              Text="Arbeitsbereich" />
            <StackPanel
              Grid.Row="1"
              Margin="0,12,0,0"
              Spacing="5">
              <TextBlock
                FontSize="11"
                Foreground="{ThemeResource GoMutedTextBrush}"
                Text="ZULETZT GEMACHT" />
              <TextBlock
                AutomationProperties.LiveSetting="Polite"
                MaxLines="2"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.RecentActivityText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="WrapWholeWords" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon
                  VerticalAlignment="Center"
                  FontSize="10"
                  Foreground="{ThemeResource GoMutedTextBrush}"
                  Glyph="&#xE823;" />
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{ThemeResource GoMutedTextBrush}"
                  Text="{x:Bind ViewModel.RecentActivityTimeText, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <primitives:Thumb
            x:Name="PaneResizeThumb"
            Width="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            AutomationProperties.HelpText="Durch Ziehen die Breite ändern."
            AutomationProperties.Name="Breite der Seitenleiste ändern"
            Background="Transparent"
            BorderBrush="{ThemeResource GoStrokeBrush}"
            BorderThickness="0,0,1,0"
            DragCompleted="OnPaneResizeCompleted"
            DragDelta="OnPaneResizeDelta"
            IsTabStop="True" />
        </Grid>
      </NavigationView.PaneHeader>

      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="AssistantItem" Content="AI Assistent" Tag="assistant">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE99A;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Projekte" Tag="projects">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE838;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Ausführungslog" Tag="logs">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9D9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="SettingsItem" Content="Einstellungen" Tag="settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Frame
        x:Name="ContentFrame"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Navigated="OnNavigated"
        NavigationFailed="OnNavigationFailed" />
    </NavigationView>

    <Border
      Grid.Row="2"
      Visibility="Collapsed"
      MinHeight="58"
      Padding="14,8"
      Background="{ThemeResource GoLayerBrush}"
      BorderBrush="{ThemeResource GoStrokeBrush}"
      BorderThickness="0,1,0,0">
      <Grid MinWidth="0">
        <ScrollViewer
          MinWidth="0"
          VerticalAlignment="Center"
          HorizontalScrollBarVisibility="Auto"
          HorizontalScrollMode="Enabled"
          VerticalScrollBarVisibility="Disabled"
          VerticalScrollMode="Disabled">
          <ItemsControl ItemsSource="{x:Bind ViewModel.AiServices, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Width="42"
                  Height="42"
                  Padding="3"
                  AutomationProperties.Name="{Binding AutomationLabel}"
                  Background="{ThemeResource GoLayerStrongBrush}"
                  BorderBrush="{ThemeResource GoStrokeBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  ToolTipService.Placement="Top"
                  ToolTipService.ToolTip="{Binding ToolTipText}">
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ActivityStates">
                      <VisualState x:Name="Idle">
                        <VisualState.StateTriggers>
                          <StateTrigger IsActive="{Binding IsIdle}" />
                        </VisualState.StateTriggers>
                      </VisualState>
                      <VisualState x:Name="Running">
                        <VisualState.StateTriggers>
                          <StateTrigger IsActive="{Binding IsBusy}" />
                        </VisualState.StateTriggers>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                          <DoubleAnimation
                            Storyboard.TargetName="ServiceIconSurfaceBrush"
                            Storyboard.TargetProperty="Opacity"
                            From="0.16"
                            To="0.58"
                            Duration="0:0:0.85">
                            <DoubleAnimation.EasingFunction>
                              <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>
                  <Grid>
                    <Border
                      x:Name="ServiceIconSurface"
                      Width="34"
                      Height="34"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      CornerRadius="7">
                      <Border.Background>
                        <SolidColorBrush
                          x:Name="ServiceIconSurfaceBrush"
                          Color="{ThemeResource GoAccentColor}"
                          Opacity="0.20" />
                      </Border.Background>
                      <Grid>
                        <FontIcon
                          x:Name="ServiceGlyph"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="16"
                          Foreground="{ThemeResource GoAccentBrush}"
                          Glyph="{Binding Glyph}" />
                        <ProgressRing
                          x:Name="ServiceProgress"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource GoAccentBrush}"
                          IsActive="{Binding IsBusy}"
                          IsTabStop="False" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
