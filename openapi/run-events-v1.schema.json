{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-ai.local/schemas/run-events-v1.schema.json",
  "title": "GO AI Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "runId", "type", "createdAt", "data"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "pattern": "^run-[a-f0-9]{32}$" },
    "type": {
      "enum": [
        "run.started",
        "queue.changed",
        "model.selected",
        "model.loading",
        "model.generation",
        "model.fallback",
        "provider.fallback",
        "context.changed",
        "text.delta",
        "server_tool.started",
        "server_tool.completed",
        "client_tool.proposed",
        "run.waiting_for_client",
        "artifact.created",
        "run.completed",
        "run.failed",
        "run.cancelled"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "text.delta" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/textDelta" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "model.generation" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/modelGeneration" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "context.changed" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "#/$defs/contextChanged" }
        }
      }
    }
  ],
  "$defs": {
    "textDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta"],
      "properties": {
        "delta": { "type": "string" },
        "replaceFrom": {
          "type": ["integer", "null"],
          "enum": [0, null],
          "description": "null oder fehlend hängt delta an. 0 ersetzt die gesamte bisherige Narration dieses Serverlaufs durch delta; vorherige Modellturns bleiben im autoritativen Text enthalten. Ermöglicht Coding-Retrykorrekturen ohne verschobene Client-Textpositionen."
        }
      }
    },
    "modelGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "description": "Modellphase. codingLoading, codingWaiting und deepResearchWaiting melden verstrichene Wartezeit; sie belegen allein keinen Tokenfortschritt. Deep Research publiziert seine Planungs-, Such-, Quellen- und Synthesephasen separat.",
          "examples": ["codingLoading", "codingWaiting", "deepResearchPlanning", "deepResearchSearch", "deepResearchFetch", "deepResearchSynthesis", "deepResearchWaiting", "deepResearchCompleted", "generationStarted", "promptProcessing", "tokenProgress", "toolSelected"]
        },
        "toolName": { "type": ["string", "null"] },
        "argumentCharacters": { "type": ["integer", "null"], "minimum": 0 },
        "promptProgress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "promptTokens": { "type": ["integer", "null"], "minimum": 0 },
        "processedPromptTokens": { "type": ["integer", "null"], "minimum": 0 },
        "generatedTokens": { "type": ["integer", "null"], "minimum": 0 },
        "tokensPerSecond": { "type": ["number", "null"], "minimum": 0 },
        "currentTokens": { "type": ["integer", "null"], "minimum": 0 },
        "attempt": { "type": ["integer", "null"], "minimum": 1 },
        "failureKind": { "type": ["string", "null"] },
        "toolArgumentsJsonComplete": { "type": ["boolean", "null"] },
        "contentCharacters": { "type": ["integer", "null"], "minimum": 0 },
        "finishObserved": { "type": ["boolean", "null"] },
        "elapsedSeconds": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "contextChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedInputTokens",
        "contextLimit",
        "loadedFiles",
        "wasCompacted",
        "contextMode",
        "documentTokens",
        "documentPages",
        "preparationCompleted",
        "historyTokens",
        "historyWasCompacted"
      ],
      "properties": {
        "estimatedInputTokens": { "type": "integer", "minimum": 0 },
        "contextLimit": { "type": "integer", "minimum": 1024 },
        "loadedFiles": { "type": "integer", "minimum": 0 },
        "wasCompacted": { "type": "boolean" },
        "detail": { "type": ["string", "null"] },
        "contextMode": { "enum": ["none", "full", "prepared"] },
        "documentTokens": { "type": "integer", "minimum": 0 },
        "documentPages": { "type": "integer", "minimum": 0 },
        "preparationCompleted": { "type": "boolean" },
        "historyTokens": { "type": "integer", "minimum": 0 },
        "historyWasCompacted": { "type": "boolean" }
      }
    }
  }
}
